rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jaring Keselamatan Global (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Fungsi Pembantu Asas
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Pengesahan Skema Profil Guru
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.createdAt is int && data.createdAt > 0;
    }

    // Pengesahan Skema Mata Pelajaran
    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'active'])
        && data.keys().hasOnly(['id', 'name', 'code', 'active'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 20
        && data.active is bool;
    }

    // Pengesahan Skema Bahan MMI
    function isValidResource(data) {
      return data.keys().hasAll([
          'title', 'description', 'subjectId', 'subjectName', 'form',
          'category', 'resourceType', 'ownerUid', 'ownerName',
          'createdAt', 'updatedAt', 'status', 'downloadCount'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'subjectId', 'subjectName', 'form',
          'category', 'resourceType', 'fileName', 'fileUrl', 'storagePath',
          'externalUrl', 'fileSizeBytes', 'ownerUid', 'ownerName', 'ownerEmail',
          'createdAt', 'updatedAt', 'status', 'downloadCount'
        ])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 250
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 3000
        && data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 64
        && data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120
        && data.form in ['Tingkatan 1', 'Tingkatan 2', 'Tingkatan 3', 'Tingkatan 4', 'Tingkatan 5']
        && data.category in ['digital', 'bukan_digital']
        && data.resourceType in ['PDF', 'DOCX', 'PPTX', 'XLSX', 'Imej', 'Video', 'Pautan Luar']
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 260))
        && (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() <= 2000))
        && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 500))
        && (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 2000))
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is int && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 52428800))
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 150
        && (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 200))
        && data.createdAt is int && data.createdAt > 0
        && data.updatedAt is int && data.updatedAt > 0
        && data.status in ['published', 'archived']
        && data.downloadCount is int && data.downloadCount >= 0;
    }

    // Pengesahan Skema Rekod Muat Turun
    function isValidDownload(data) {
      return data.keys().hasAll(['resourceId', 'downloadedAt'])
        && data.keys().hasOnly(['resourceId', 'uid', 'downloadedAt'])
        && isValidId(data.resourceId)
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
        && data.downloadedAt is int && data.downloadedAt > 0;
    }

    // Koleksi Profil Guru (PII Terasing - Akses Pemilik Sahaja)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'photoURL']);
      allow delete: if false;
    }

    // Koleksi Mata Pelajaran
    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(subjectId)
        && isValidSubject(incoming());
      allow update, delete: if false;
    }

    // Koleksi Bahan Instruksional (resources)
    match /resources/{resourceId} {
      allow get: if isValidId(resourceId)
        && (existing().status == 'published' || (isSignedIn() && existing().ownerUid == request.auth.uid));
      allow list: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(resourceId)
        && isValidResource(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().downloadCount == 0
        && incoming().status == 'published';

      allow update: if isValidId(resourceId)
        && isValidResource(incoming())
        && (
          // Tindakan 1: Pemilik mengemas kini butiran bahan
          (
            isVerifiedUser()
            && existing().ownerUid == request.auth.uid
            && incoming().ownerUid == existing().ownerUid
            && incoming().createdAt == existing().createdAt
            && incoming().downloadCount == existing().downloadCount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'subjectId', 'subjectName', 'form',
              'category', 'resourceType', 'fileName', 'fileUrl', 'storagePath',
              'externalUrl', 'fileSizeBytes', 'updatedAt', 'status'
            ])
          )
          ||
          // Tindakan 2: Penambahan kiraan muat turun pada bahan diterbitkan
          (
            existing().status == 'published'
            && incoming().diff(existing()).affectedKeys().hasOnly(['downloadCount'])
            && incoming().downloadCount == existing().downloadCount + 1
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(resourceId)
        && existing().ownerUid == request.auth.uid;
    }

    // Koleksi Log Muat Turun
    match /downloads/{downloadId} {
      allow get, list, update, delete: if false;
      allow create: if isValidId(downloadId)
        && isValidDownload(incoming())
        && exists(/databases/$(database)/documents/resources/$(incoming().resourceId));
    }
  }
}
